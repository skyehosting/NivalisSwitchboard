<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>NivalisSwitchboard</AssemblyName>
    <RootNamespace>NivalisSwitchboard</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <Version>0.5.5</Version>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <DebugType>embedded</DebugType>
    <PathMap>$(MSBuildProjectDirectory)=NivalisSwitchboard</PathMap>
    <!-- The game folder; override with -p:GameDir=... -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Nivalis Nights</GameDir>
    <BepCore>$(GameDir)\BepInEx\core</BepCore>
    <Interop>$(GameDir)\BepInEx\interop</Interop>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests\**;tools\**;release\**" />
    <None Remove="tests\**;tools\**;release\**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(BepCore)\BepInEx.Core.dll" Private="false" />
    <Reference Include="$(BepCore)\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(BepCore)\BepInEx.Unity.Common.dll" Private="false" />
    <Reference Include="$(BepCore)\0Harmony.dll" Private="false" />
    <Reference Include="$(BepCore)\SemanticVersioning.dll" Private="false" />
    <Reference Include="$(BepCore)\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(BepCore)\Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(Interop)\Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="$(Interop)\Il2CppSystem.Core.dll" Private="false" />
    <Reference Include="$(Interop)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(Interop)\Assembly-CSharp-firstpass.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.AnimationModule.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.AIModule.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.AudioModule.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.ScreenCaptureModule.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.ImageConversionModule.dll" Private="false" />
    <Reference Include="$(Interop)\Unity.Postprocessing.Runtime.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="$(Interop)\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="$(Interop)\Unity.InputSystem.dll" Private="false" />
  </ItemGroup>

</Project>
